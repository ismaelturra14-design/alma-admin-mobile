{
  "expo": {
    "name": "Alma Médica",
    "slug": "alma-medica-mobile",
    "scheme": "alma-medica",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.almamedica.mobile"
    },
    "android": {
      "package": "com.almamedica.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#effaff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Alma Médica necesita acceso a tus fotos para adjuntar la imagen del usuario o su firma.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07566f",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": {
                "light": "#306b94",
                "dark": "#82bce4"
              },
              "textColorPrimary": {
                "light": "#132731",
                "dark": "#eef6f9"
              },
              "textColorSecondary": {
                "light": "#4a626f",
                "dark": "#bacbd2"
              },
              "windowBackground": {
                "light": "#effaff",
                "dark": "#1a272d"
              }
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
