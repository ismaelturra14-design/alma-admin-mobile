{
  "expo": {
    "name": "Alma Médica",
    "slug": "alma-medica-mobile",
    "scheme": "alma-medica",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./src/images/AlmaIconApp.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.almamedica.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Alma Médica necesita acceso a tus fotos para adjuntar la imagen del usuario o su firma."
      }
    },
    "android": {
      "package": "com.almamedica.mobile",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "com.google.android.gms.permission.AD_ID"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./src/images/AlmaIconApp.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36,
            "usesCleartextTraffic": false
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Alma Médica necesita acceso a tus fotos para adjuntar la imagen del usuario o su firma.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./src/images/AlmaIconApp.png",
          "imageWidth": 200
        }
      ],
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": {
                "light": "#306b94",
                "dark": "#82bce4"
              },
              "textColorPrimary": {
                "light": "#132731",
                "dark": "#eef6f9"
              },
              "textColorSecondary": {
                "light": "#4a626f",
                "dark": "#bacbd2"
              },
              "windowBackground": {
                "light": "#effaff",
                "dark": "#1a272d"
              }
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1fc8c309-6645-4d91-8af3-eabaf379a1cc"
      }
    },
    "owner": "ueuismaaaaa"
  }
}
